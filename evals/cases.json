          "type": "every_recommendation_cites_source"
        },
        {
          "type": "first_state",
          "equals": "feasible"
        },
        {
          "type": "state",
          "intervention_id": "reduced_tillage",
          "equals": "feasible"
        },
        {
          "type": "state",
          "intervention_id": "electric_tractor",
          "equals": "not_feasible"
        },
        {
          "type": "state",
          "intervention_id": "correct_tyre_pressure",
          "equals": "needs_info"
        }
      ]
    },
