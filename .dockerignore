# Keep the build context small and free of secrets: the Dockerfile copies only what the API needs.
.git
.gitignore
.claude/
CLAUDE.md
.env*
*.json.key
**/__pycache__/
.venv/
.pytest_cache/
data/raw/
data/prep/
data/synthetic/
**/*.zip
**/*.pkl
**/*.parquet
frontend/
tests/
evals/*
!evals/results/
docs/
infra/
