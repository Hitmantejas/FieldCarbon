# Filled in at start-up: ${PORT} and ${BACKEND_URL} come from the Cloud Run service settings.
server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Cloud Run addresses change, so the backend name is looked up again as needed, not once at start-up.
    resolver 8.8.8.8 valid=30s ipv6=off;

    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        # The address Cloud Run saw for the visitor, last in the incoming list. The backend counts its own hop after it
        # (FIELDCARBON_TRUSTED_PROXIES=1), so each visitor keeps their own question limit.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        # Answers arrive step by step: send each one on as it comes, and allow a slow model.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri /index.html;
    }
}
